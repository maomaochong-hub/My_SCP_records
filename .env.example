# ---- 运行 ----
PORT=8787
NODE_ENV=development
# 允许的来源，逗号分隔多值；写请求的 Origin 必须在这里面（否则 403 来源校验失败）
# 本地：localhost 与 127.0.0.1 是两个不同的源，两个都写上比较省心
# 生产：换成 https://yourdomain.com,https://www.yourdomain.com
PUBLIC_ORIGIN=http://127.0.0.1:8787,http://localhost:8787
SITE_TZ=Asia/Shanghai

# ---- 存储 ----
# file = 本地 JSON（默认）；cloudbase = 腾讯云 CloudBase 云数据库（部署时启用）
STORAGE_DRIVER=file
DATA_DIR=./data

# ---- 密钥（生产环境必须全部替换为随机 32 字节，且不要提交仓库）----
SESSION_SECRET=please-change-to-random-32-bytes
AUTH_PEPPER=please-change-to-random-32-bytes
STATS_SECRET=please-change-to-random-32-bytes

# ---- 所有者账号（只被 scripts/seed.js 读取）----
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=

# ---- 会话 Cookie ----
# 生产环境：__Host-scp_sid + COOKIE_SECURE=true（必须 HTTPS）
COOKIE_NAME=scp_sid
COOKIE_SECURE=false

# ---- 反向代理 ----
# 部署在 CDN / 云托管后面时设为 true，从 X-Forwarded-For 取真实 IP
TRUST_PROXY=false

# ---- 统计 ----
# true = 所有者自己的访问不计 UV（仍计 PV）
STATS_EXCLUDE_OWNER=true

# ---- 网页创作 ----
MAX_VERSIONS_PER_WORK=50
